generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  STUDENT
  AUDITOR
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
  LOCKED
}

enum AuthorizationLevel {
  BASIC
  TRUSTED
  STAFF
}

enum AssetScope {
  PUBLIC
  INTERNAL
  SPECIAL
}

enum LoginProvider {
  UNIFIED_CODE_PASSWORD
  EMAIL_CODE
  SCHOOL_SSO
}

enum VulnerabilitySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum VulnerabilityStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  NEEDS_SUPPLEMENT
  CONFIRMED
  FIXING
  PENDING_RETEST
  ARCHIVED
  CERTIFIED
  REJECTED
}

enum AttachmentKind {
  VULNERABILITY_REPORT
  RETEST_EVIDENCE
}

enum ReviewDecision {
  CONFIRM
  NEEDS_SUPPLEMENT
  REJECT
  RETEST_PASS
  RETURN_TO_FIX
  ARCHIVE
}

enum CertificateStatus {
  PENDING
  ISSUED
  REVOKED
}

enum PointDirection {
  IN
  OUT
  ADJUST
}

enum MallRedemptionStatus {
  PENDING_PICKUP
  COMPLETED
  CANCELED
  EXPIRED
}

enum MallProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum LearningResourceKind {
  RESOURCE
  RANGE
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  OFFLINE
}

enum AnnouncementRange {
  ALL
  STUDENTS
  AUDITORS
  ADMINS
}

enum AiSpace {
  STUDENT
  AUDITOR
  ADMIN
}

enum AiCallPurpose {
  CHAT
  VULNERABILITY_PARSE
  SECURITY_QUESTION_GENERATION
  VULNERABILITY_VALUE_REVIEW
  LEARNING_RECOMMENDATION
  REPORT_SUMMARY
  AUDIT_ANALYSIS
}

enum SecurityQuestionType {
  SINGLE_CHOICE
  TRUE_FALSE
  MULTIPLE_CHOICE
}

enum AiProposalStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}


enum AiKnowledgeCategory {
  VULNERABILITY_REPORTING
  XSS
  SQL_INJECTION
  SSRF
  FILE_UPLOAD
  ACCESS_CONTROL
  AUTHENTICATION
  SECURITY_LEARNING
  SRC_RULES
  PLATFORM_USAGE
  AUDITOR_REVIEW
  ADMIN_ANALYTICS
}

enum AiKnowledgeRoleScope {
  STUDENT
  AUDITOR
  ADMIN
  ALL
}

enum AiKnowledgeVisibility {
  PRIVATE
  REVIEW_REQUIRED
  PLATFORM_PUBLIC
  ROLE_ONLY
}

enum AiKnowledgeSensitivity {
  PUBLIC
  INTERNAL
  SENSITIVE
  REJECTED
}

enum AiKnowledgeStatus {
  CANDIDATE
  AUTO_APPROVED
  NEEDS_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
  PROMOTED_TO_SKILL
}

enum AiKnowledgeSource {
  USER_CHAT
  ADMIN_CREATED
  DOC_IMPORT
  SKILL_PROMOTION
}

enum AiKnowledgeFeedbackValue {
  HELPFUL
  UNHELPFUL
  REPORT_ABUSE
}

enum AiKnowledgeJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DISCARDED
}

enum AiKnowledgeConversationStatus {
  ACTIVE
  READY_REVIEW
  APPROVED_TO_KB
  SKILL_CANDIDATE
  DISCARDED
}

enum AiProblemSessionStatus {
  ACTIVE
  AWAITING_RESOLUTION
  RESOLVED
  READY_REVIEW
  APPROVED_TO_KB
  SKILL_CANDIDATE
  DISCARDED
  ARCHIVED
}

enum AiSkillCandidateStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  REJECTED
  INSTALLED
  FAILED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE_VULNERABILITY
  SUBMIT_VULNERABILITY
  VIEW_SENSITIVE_ATTACHMENT
  REVIEW_VULNERABILITY
  CHANGE_VULNERABILITY_STATUS
  ISSUE_CERTIFICATE
  REVOKE_CERTIFICATE
  PUBLISH_ANNOUNCEMENT
  MANAGE_LEARNING_RESOURCE
  MANAGE_MALL
  MANAGE_USER
  CHANGE_USER_PERMISSION
  CHANGE_SYSTEM_SETTING
  CALL_AI
}

model User {
  id                    String              @id @default(cuid())
  roleId                String
  role                  Role                @relation(fields: [roleId], references: [id])
  unifiedCode           String              @unique
  email                 String              @unique
  emailVerifiedAt       DateTime?
  passwordHash          String?
  name                  String
  studentNo             String?             @unique
  college               String?
  grade                 String?
  identityText          String?
  avatarUrl             String?
  authorizationLevel    AuthorizationLevel  @default(BASIC)
  authorizationSourceId String?
  status                UserStatus          @default(PENDING)
  pendingRegistrationApproval Boolean        @default(false)
  lastLoginAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  emailCodes            EmailVerificationCode[]
  authorizationSource   AuthorizationSource?      @relation(fields: [authorizationSourceId], references: [id])
  refreshTokens         RefreshToken[]
  permissionOverrides   UserPermissionOverride[]
  examAttempts          SecurityExamAttempt[]
  createdSecurityQuestions SecurityQuestion[]      @relation("SecurityQuestionCreator")
  responsibilitySigns   ResponsibilitySignature[]
  submittedReports      VulnerabilityReport[]     @relation("ReportSubmitter")
  assignedReviews       ReviewAssignment[]         @relation("AssignmentAuditor")
  reviewComments        ReviewComment[]            @relation("ReviewCommentAuthor")
  uploadedAttachments   VulnerabilityAttachment[]  @relation("AttachmentUploader")
  vulnerabilityEvents   VulnerabilityEvent[]       @relation("VulnerabilityEventActor")
  retestRecords         RetestRecord[]             @relation("RetestTester")
  receivedCertificates  Certificate[]              @relation("CertificateRecipient")
  issuedCertificates    Certificate[]              @relation("CertificateIssuer")
  revokedCertificates   Certificate[]              @relation("CertificateRevoker")
  createdCertificateTemplates CertificateTemplate[] @relation("CertificateTemplateCreator")
  pointEntries          PointLedgerEntry[]          @relation("PointUser")
  operatedPointEntries  PointLedgerEntry[]          @relation("PointOperator")
  redemptions           MallRedemption[]            @relation("RedemptionUser")
  handledRedemptions    MallRedemption[]            @relation("RedemptionHandler")
  createdMallProducts   MallProduct[]               @relation("MallProductCreator")
  announcements         Announcement[]             @relation("AnnouncementAuthor")
  aiCallLogs            AiCallLog[]                 @relation("AiCallUser")
  aiQuota               AiUserQuota?                @relation("UserAiQuota")
  aiSkills              AiSkill[]                   @relation("AiSkillCreator")
  aiFaqEntries          AiFaqEntry[]                @relation("AiFaqCreator")
  aiActionProposals     AiActionProposal[]          @relation("AiProposalRequester")
  approvedAiProposals   AiActionProposal[]          @relation("AiProposalApprover")
  knowledgeEntries       AiKnowledgeEntry[]          @relation("AiKnowledgeSourceUser")
  reviewedKnowledgeEntries AiKnowledgeEntry[]        @relation("AiKnowledgeReviewer")
  knowledgeRevisions    AiKnowledgeRevision[]       @relation("AiKnowledgeRevisionEditor")
  knowledgeHits         AiKnowledgeHit[]            @relation("AiKnowledgeHitUser")
  knowledgeFeedbacks    AiKnowledgeFeedback[]       @relation("AiKnowledgeFeedbackUser")
  aiKnowledgeConversations AiKnowledgeConversation[] @relation("AiKnowledgeConversationUser")
  reviewedAiKnowledgeConversations AiKnowledgeConversation[] @relation("AiKnowledgeConversationReviewer")
  aiProblemSessions     AiProblemSession[]           @relation("AiProblemSessionUser")
  reviewedSkillCandidates AiSkillCandidate[]         @relation("AiSkillCandidateReviewer")
  operatedSkillInstalls AiSkillInstallLog[]         @relation("AiSkillInstallOperator")
  auditLogs             AuditLog[]                  @relation("AuditActor")

  @@index([roleId])
  @@index([authorizationLevel])
  @@index([authorizationSourceId])
  @@index([status])
}

model AuthorizationSource {
  id          String              @id @default(cuid())
  code        String              @unique
  name        String
  description String?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  users       User[]
}

model AuthorizationPolicy {
  id          String              @id @default(cuid())
  level       AuthorizationLevel
  scope       AssetScope
  allowed     Boolean             @default(true)
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([level, scope])
}

model Role {
  id          String           @id @default(cuid())
  code        RoleCode         @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id              String                   @id @default(cuid())
  code            String                   @unique
  name            String
  description     String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  roles           RolePermission[]
  userOverrides   UserPermissionOverride[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

model UserPermissionOverride {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  enabled      Boolean
  reason       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([permissionId])
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  userId     String?
  email      String
  codeHash   String
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([expiresAt])
}

model CaptchaChallenge {
  id          String         @id @default(cuid())
  purpose     String
  answerRatio Float
  expiresAt   DateTime
  verifiedAt  DateTime?
  attempts    Int            @default(0)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())
  tokens      CaptchaToken[]

  @@index([purpose, expiresAt])
  @@index([ipAddress, createdAt])
}

model CaptchaToken {
  id          String           @id @default(cuid())
  challengeId String
  tokenHash   String           @unique
  purpose     String
  expiresAt   DateTime
  consumedAt  DateTime?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime         @default(now())
  challenge   CaptchaChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
  @@index([purpose, expiresAt])
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SecurityExamAttempt {
  id            String    @id @default(cuid())
  userId        String
  score         Int?
  totalScore    Int       @default(100)
  threshold     Int       @default(80)
  questionCount Int       @default(0)
  correctCount  Int       @default(0)
  detailJson    Json?
  passed        Boolean
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, passed])
}

model SecurityQuestion {
  id          String               @id @default(cuid())
  type        SecurityQuestionType
  stem        String               @db.Text
  options     Json
  answerKeys  String[]
  explanation String?              @db.Text
  source      String               @default("ADMIN")
  active      Boolean              @default(true)
  createdById String?
  createdBy   User?                @relation("SecurityQuestionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?

  @@index([type, active])
  @@index([createdAt])
  @@index([createdById])
}

model ResponsibilityAgreement {
  id          String                    @id @default(cuid())
  version     String                    @unique
  title       String
  contentHash String
  content     String                    @db.Text
  active      Boolean                   @default(false)
  publishedAt DateTime?
  createdAt   DateTime                  @default(now())
  signatures  ResponsibilitySignature[]
}

model ResponsibilitySignature {
  id                String                  @id @default(cuid())
  userId            String
  agreementId       String
  signedAt          DateTime                @default(now())
  ipAddress         String?
  userAgent         String?
  deviceFingerprint String?
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreement         ResponsibilityAgreement @relation(fields: [agreementId], references: [id])

  @@unique([userId, agreementId])
  @@index([signedAt])
}

model Asset {
  id             String                @id @default(cuid())
  name           String
  url            String?
  ownerUnit      String
  scope          AssetScope            @default(PUBLIC)
  description    String?
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  reports        VulnerabilityReport[]

  @@index([ownerUnit])
  @@index([scope])
}

model VulnerabilityReport {
  id                  String                  @id @default(cuid())
  reportNo            String                  @unique
  submitterId         String
  assetId             String?
  title               String
  assetName           String
  assetUrl            String?
  ownerUnit           String?
  vulnerabilityType   String
  selfSeverity        VulnerabilitySeverity
  finalSeverity       VulnerabilitySeverity?
  status              VulnerabilityStatus     @default(DRAFT)
  reproductionSteps   String                  @db.Text
  impactAssessment    String                  @db.Text
  repairSuggestion    String                  @db.Text
  requestPacket       String?                 @db.Text
  testBoundary        String?                 @db.Text
  aiParsed            Boolean                 @default(false)
  submittedAt         DateTime?
  confirmedAt         DateTime?
  archivedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  deletedAt           DateTime?

  submitter           User                    @relation("ReportSubmitter", fields: [submitterId], references: [id])
  asset               Asset?                  @relation(fields: [assetId], references: [id])
  attachments         VulnerabilityAttachment[]
  events              VulnerabilityEvent[]
  assignment          ReviewAssignment?
  comments            ReviewComment[]
  retests             RetestRecord[]
  certificate         Certificate?
  pointEntries        PointLedgerEntry[]
  aiActionProposals   AiActionProposal[]

  @@index([submitterId])
  @@index([assetId])
  @@index([status])
  @@index([finalSeverity])
  @@index([createdAt])
}

model VulnerabilityAttachment {
  id              String              @id @default(cuid())
  reportId        String
  uploaderId      String
  kind            AttachmentKind
  originalName    String
  storageKey      String              @unique
  mimeType        String
  sizeBytes       Int
  sha256          String
  pageCount       Int?
  uploadedAt      DateTime            @default(now())
  deletedAt       DateTime?
  report          VulnerabilityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploader        User                @relation("AttachmentUploader", fields: [uploaderId], references: [id])

  @@index([reportId])
  @@index([sha256])
}

model VulnerabilityEvent {
  id             String                @id @default(cuid())
  reportId       String
  actorId        String?
  action         String
  fromStatus     VulnerabilityStatus?
  toStatus       VulnerabilityStatus?
  note           String?               @db.Text
  ipAddress      String?
  userAgent      String?
  deviceInfo     String?
  createdAt      DateTime              @default(now())
  report         VulnerabilityReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor          User?                 @relation("VulnerabilityEventActor", fields: [actorId], references: [id])

  @@index([reportId, createdAt])
  @@index([actorId])
}

model ReviewAssignment {
  id         String              @id @default(cuid())
  reportId   String              @unique
  auditorId  String
  assignedAt DateTime            @default(now())
  closedAt   DateTime?
  report     VulnerabilityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  auditor    User                @relation("AssignmentAuditor", fields: [auditorId], references: [id])

  @@index([auditorId])
}

model ReviewComment {
  id        String              @id @default(cuid())
  reportId  String
  authorId  String
  decision  ReviewDecision?
  content   String              @db.Text
  createdAt DateTime            @default(now())
  report    VulnerabilityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author    User                @relation("ReviewCommentAuthor", fields: [authorId], references: [id])

  @@index([reportId])
  @@index([authorId])
}

model RetestRecord {
  id                String              @id @default(cuid())
  reportId          String
  testerId          String
  result            ReviewDecision
  note              String?             @db.Text
  evidenceStorageKey String?
  evidenceSha256    String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime            @default(now())
  report            VulnerabilityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  tester            User                @relation("RetestTester", fields: [testerId], references: [id])

  @@index([reportId])
  @@index([testerId])
}

model Certificate {
  id              String              @id @default(cuid())
  certificateNo   String              @unique
  vulnerabilityId String              @unique
  recipientId     String
  issuedById      String?
  status          CertificateStatus   @default(PENDING)
  verifyCode      String              @unique
  publicVerify    Boolean             @default(true)
  publicVerifyCount Int               @default(0)
  contribution    String              @db.Text
  issuedAt        DateTime?
  revokedAt       DateTime?
  revokedById     String?
  revokeReason    String?             @db.Text
  pdfStorageKey   String?
  templateId      String?
  templateSnapshot Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  vulnerability   VulnerabilityReport @relation(fields: [vulnerabilityId], references: [id])
  recipient       User                @relation("CertificateRecipient", fields: [recipientId], references: [id])
  issuedBy        User?               @relation("CertificateIssuer", fields: [issuedById], references: [id])
  revokedBy       User?               @relation("CertificateRevoker", fields: [revokedById], references: [id])
  template        CertificateTemplate? @relation(fields: [templateId], references: [id])

  @@index([recipientId])
  @@index([issuedById])
  @@index([status])
  @@index([templateId])
}

model CertificateTemplate {
  id                 String        @id @default(cuid())
  name               String
  version            String        @unique
  templateStorageKey String
  templateMimeType   String
  templateSizeBytes  Int
  templateSha256     String
  sealStorageKey     String?
  sealMimeType       String?
  sealSizeBytes      Int?
  sealSha256         String?
  layoutJson         Json
  active             Boolean       @default(false)
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  createdBy          User?         @relation("CertificateTemplateCreator", fields: [createdById], references: [id])
  certificates       Certificate[]

  @@index([active])
  @@index([createdById])
}

model PointLedgerEntry {
  id              String              @id @default(cuid())
  userId          String
  operatorId      String?
  reportId        String?
  redemptionId    String?
  direction       PointDirection
  points          Int
  balanceAfter    Int
  reason          String
  note            String?             @db.Text
  createdAt       DateTime            @default(now())
  user            User                @relation("PointUser", fields: [userId], references: [id])
  operator        User?               @relation("PointOperator", fields: [operatorId], references: [id])
  report          VulnerabilityReport? @relation(fields: [reportId], references: [id])
  redemption      MallRedemption?      @relation(fields: [redemptionId], references: [id])

  @@index([userId, createdAt])
  @@index([reportId])
  @@index([redemptionId])
}

model MallProduct {
  id                 String            @id @default(cuid())
  name               String
  category           String            @default("实体奖励")
  description        String?           @db.Text
  imageUrl           String?
  pointsCost         Int
  stock              Int
  status             MallProductStatus @default(DRAFT)
  perUserLimit       Int               @default(1)
  pickupLocation     String?           @default("蓝山工作室")
  pickupInstructions String?           @db.Text
  sortOrder          Int               @default(0)
  createdById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  redemptions        MallRedemption[]
  createdBy          User?             @relation("MallProductCreator", fields: [createdById], references: [id])

  @@index([status])
  @@index([category])
  @@index([sortOrder])
}

model MallRedemption {
  id           String                @id @default(cuid())
  userId       String
  productId    String
  handlerId    String?
  pointsCost   Int
  status       MallRedemptionStatus  @default(PENDING_PICKUP)
  pickupCode   String                @unique
  requestedAt  DateTime              @default(now())
  completedAt  DateTime?
  canceledAt   DateTime?
  expiresAt    DateTime?
  note         String?               @db.Text
  user         User                  @relation("RedemptionUser", fields: [userId], references: [id])
  product      MallProduct           @relation(fields: [productId], references: [id])
  handler      User?                 @relation("RedemptionHandler", fields: [handlerId], references: [id])
  events       MallRedemptionEvent[]
  pointEntries PointLedgerEntry[]

  @@index([userId])
  @@index([productId])
  @@index([status])
}

model MallRedemptionEvent {
  id           String                @id @default(cuid())
  redemptionId String
  actorId      String?
  fromStatus   MallRedemptionStatus?
  toStatus     MallRedemptionStatus
  note         String?               @db.Text
  createdAt    DateTime              @default(now())
  redemption   MallRedemption        @relation(fields: [redemptionId], references: [id], onDelete: Cascade)

  @@index([redemptionId, createdAt])
}

model LearningResource {
  id            String               @id @default(cuid())
  kind          LearningResourceKind
  category      String
  title         String
  description   String?              @db.Text
  externalUrl   String
  coverUrl      String?
  downloadCount Int                  @default(0)
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  @@index([kind])
  @@index([category])
  @@index([active])
}

model Announcement {
  id          String            @id @default(cuid())
  title       String
  category    String
  status      AnnouncementStatus @default(DRAFT)
  range       AnnouncementRange
  pinned      Boolean           @default(false)
  summary     String            @db.Text
  content     String            @db.Text
  authorId    String
  publishedAt DateTime?
  offlineAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  author      User              @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  @@index([status])
  @@index([range])
  @@index([pinned])
}

model AiCallLog {
  id                    String        @id @default(cuid())
  userId                String?
  aiSpace               AiSpace
  purpose               AiCallPurpose
  sanitizedInputSummary String        @db.Text
  outputSummary         String?       @db.Text
  modelName             String?
  hermesRunId           String?
  tokensUsed            Int?
  requiresHumanConfirm  Boolean       @default(true)
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime      @default(now())
  user                  User?         @relation("AiCallUser", fields: [userId], references: [id])

  @@index([aiSpace, purpose])
  @@index([userId, createdAt])
}

model AiUserQuota {
  id           String   @id @default(cuid())
  userId       String   @unique
  dailyLimit   Int?
  weeklyLimit  Int?
  monthlyLimit Int
  enabled      Boolean  @default(true)
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation("UserAiQuota", fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@index([updatedAt])
}

model AiSkill {
  id          String    @id @default(cuid())
  aiSpace     AiSpace
  title       String
  content     String    @db.Text
  source      String?
  createdById String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   User?     @relation("AiSkillCreator", fields: [createdById], references: [id])

  @@index([aiSpace])
  @@index([active])
}

model AiFaqEntry {
  id          String    @id @default(cuid())
  aiSpace     AiSpace
  questionKey String
  question    String    @db.Text
  answer      String    @db.Text
  hitCount    Int       @default(0)
  createdById String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   User?     @relation("AiFaqCreator", fields: [createdById], references: [id])

  @@unique([aiSpace, questionKey])
  @@index([active])
}

model AiActionProposal {
  id              String              @id @default(cuid())
  aiSpace          AiSpace
  requesterId      String?
  approverId       String?
  reportId         String?
  actionType       String
  sanitizedReason  String             @db.Text
  payload          Json
  status           AiProposalStatus   @default(PENDING)
  decidedAt        DateTime?
  createdAt        DateTime           @default(now())
  requester        User?              @relation("AiProposalRequester", fields: [requesterId], references: [id])
  approver         User?              @relation("AiProposalApprover", fields: [approverId], references: [id])
  report           VulnerabilityReport? @relation(fields: [reportId], references: [id])

  @@index([aiSpace, status])
  @@index([reportId])
}

model AiKnowledgeConversation {
  id                     String                         @id @default(cuid())
  userId                 String?
  aiSpace                AiSpace
  status                 AiKnowledgeConversationStatus @default(ACTIVE)
  title                  String
  problemStatement       String                         @db.Text
  resolutionSummary      String?                        @db.Text
  pitfalls               String[]                       @default([])
  environmentNotes       String[]                       @default([])
  successfulSteps        String[]                       @default([])
  failedAttempts         String[]                       @default([])
  collectedEvidence      String[]                       @default([])
  suggestedKnowledgeType String                         @default("KB")
  autoDecisionReason     String?                        @db.Text
  aiOverallScore         Float                          @default(0)
  aiKbScore              Float                          @default(0)
  aiSkillScore           Float                          @default(0)
  aiSafetyScore          Float                          @default(0)
  aiPrivacyRiskScore     Float                          @default(1)
  aiConfidenceScore      Float                          @default(0)
  aiAutoApproveThreshold Float                          @default(0.88)
  aiReviewThreshold      Float                          @default(0.62)
  aiEvaluation           Json?
  duplicateRiskScore     Float                          @default(0)
  similarKnowledgeMatches Json?
  mergeSuggestion        String?                        @db.Text
  topicKey               String
  turnCount              Int                            @default(0)
  lastUserMessage        String?                        @db.Text
  sourceCallIds          String[]                       @default([])
  reviewedById           String?
  reviewedAt             DateTime?
  reviewNote             String?                        @db.Text
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  user                   User?                          @relation("AiKnowledgeConversationUser", fields: [userId], references: [id])
  reviewedBy             User?                          @relation("AiKnowledgeConversationReviewer", fields: [reviewedById], references: [id])
  turns                  AiKnowledgeConversationTurn[]
  knowledgeEntries       AiKnowledgeEntry[]             @relation("AiKnowledgeConversationEntry")

  @@index([status, updatedAt])
  @@index([userId, aiSpace, updatedAt])
  @@index([aiSpace, topicKey, updatedAt])
}

model AiKnowledgeConversationTurn {
  id             String                  @id @default(cuid())
  conversationId String
  callId         String?
  role           String
  content        String                  @db.Text
  contentHash    String
  createdAt      DateTime                @default(now())

  conversation   AiKnowledgeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([contentHash])
  @@unique([conversationId, contentHash])
}

model AiProblemSession {
  id                 String                 @id @default(cuid())
  userId             String?
  clusterId          String?
  aiSpace            AiSpace
  mode               String
  title              String?
  topicKey           String?
  initialQuestion    String                 @db.Text
  status             AiProblemSessionStatus @default(ACTIVE)
  startedAt          DateTime               @default(now())
  lastActiveAt       DateTime               @default(now())
  leftAt             DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  resolutionByUser   Boolean?
  userOutcomeNote    String?                @db.Text
  turnCount          Int                    @default(0)
  tokenEstimate      Int                    @default(0)
  summaryJson        Json?
  knowledgeEntryId   String?
  duplicateRiskScore Float                  @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user               User?                  @relation("AiProblemSessionUser", fields: [userId], references: [id])
  cluster            AiKnowledgeCluster?    @relation(fields: [clusterId], references: [id])
  turns              AiProblemSessionTurn[]

  @@index([userId, status, updatedAt])
  @@index([clusterId])
  @@index([topicKey, status])
  @@index([status, lastActiveAt])
}

model AiKnowledgeCluster {
  id                       String             @id @default(cuid())
  aiSpace                  AiSpace
  topicKey                 String
  representativeProblem    String             @db.Text
  representativeResolution String?            @db.Text
  resolvedSessionCount     Int                @default(0)
  totalAskCount            Int                @default(0)
  avgQualityScore          Float              @default(0)
  avgReuseScore            Float              @default(0)
  avgSafetyScore           Float              @default(0)
  duplicateRiskScore       Float              @default(0)
  similarKnowledgeMatches  Json?
  mergeSuggestion          String?            @db.Text
  lastResolvedAt           DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  sessions                 AiProblemSession[]

  @@unique([aiSpace, topicKey])
  @@index([aiSpace, updatedAt])
  @@index([duplicateRiskScore])
}

model AiProblemSessionTurn {
  id            String           @id @default(cuid())
  sessionId     String
  role          String
  contentHash   String?
  sanitizedText String           @db.Text
  sourceCallId  String?
  hasAttachment Boolean          @default(false)
  metadata      Json?
  createdAt     DateTime         @default(now())

  session       AiProblemSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([contentHash])
}

model AiKnowledgeEntry {
  id                     String                  @id @default(cuid())
  title                  String
  canonicalQuestion      String                  @db.Text
  canonicalAnswer        String                  @db.Text
  summary                String?                 @db.Text
  category               AiKnowledgeCategory
  tags                   String[]
  roleScope              AiKnowledgeRoleScope
  visibility             AiKnowledgeVisibility
  sensitivity            AiKnowledgeSensitivity
  status                 AiKnowledgeStatus       @default(CANDIDATE)
  source                 AiKnowledgeSource       @default(USER_CHAT)
  sourceCallId           String?
  sourceConversationId   String?
  sourceUserId           String?
  sourceHash             String                  @unique
  sanitizedInputHash     String?
  similarityKey          String?
  embeddingModel         String?
  embeddingDimension     Int?
  embeddingJson          Json?
  generalityScore        Float                   @default(0)
  safetyScore            Float                   @default(0)
  privacyRiskScore       Float                   @default(1)
  educationalValueScore  Float                   @default(0)
  reuseValueScore        Float                   @default(0)
  answerQualityScore     Float                   @default(0)
  platformRelevanceScore Float                   @default(0)
  confidenceScore        Float                   @default(0)
  hitCount               Int                     @default(0)
  helpfulCount           Int                     @default(0)
  unhelpfulCount         Int                     @default(0)
  abuseReportCount       Int                     @default(0)
  promotedSkillId        String?
  reviewedById           String?
  reviewedAt             DateTime?
  reviewNote             String?                 @db.Text
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  archivedAt             DateTime?

  sourceUser             User?                   @relation("AiKnowledgeSourceUser", fields: [sourceUserId], references: [id])
  sourceConversation     AiKnowledgeConversation? @relation("AiKnowledgeConversationEntry", fields: [sourceConversationId], references: [id])
  reviewedBy             User?                   @relation("AiKnowledgeReviewer", fields: [reviewedById], references: [id])
  hits                   AiKnowledgeHit[]
  feedbacks              AiKnowledgeFeedback[]
  revisions              AiKnowledgeRevision[]

  @@index([status, updatedAt])
  @@index([roleScope, status])
  @@index([category, status])
  @@index([sourceCallId])
  @@index([sourceConversationId])
  @@index([sourceUserId])
  @@index([similarityKey])
}

model AiKnowledgeRevision {
  id                String            @id @default(cuid())
  knowledgeId       String
  editorId          String?
  title             String
  canonicalQuestion String            @db.Text
  canonicalAnswer   String            @db.Text
  changeReason      String?           @db.Text
  createdAt         DateTime          @default(now())

  knowledge         AiKnowledgeEntry  @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  editor            User?             @relation("AiKnowledgeRevisionEditor", fields: [editorId], references: [id])

  @@index([knowledgeId, createdAt])
  @@index([editorId])
}

model AiKnowledgeHit {
  id              String            @id @default(cuid())
  knowledgeId     String
  userId          String?
  aiSpace         AiSpace
  questionHash    String
  questionSummary String            @db.Text
  similarity      Float
  route           String
  usedInResponse  Boolean           @default(false)
  createdAt       DateTime          @default(now())

  knowledge       AiKnowledgeEntry  @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  user            User?             @relation("AiKnowledgeHitUser", fields: [userId], references: [id])

  @@index([knowledgeId, createdAt])
  @@index([userId, createdAt])
  @@index([aiSpace, createdAt])
  @@index([questionHash])
}

model AiKnowledgeFeedback {
  id          String                   @id @default(cuid())
  knowledgeId String
  userId      String?
  value       AiKnowledgeFeedbackValue
  note        String?                  @db.Text
  createdAt   DateTime                 @default(now())

  knowledge   AiKnowledgeEntry         @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  user        User?                    @relation("AiKnowledgeFeedbackUser", fields: [userId], references: [id])

  @@index([knowledgeId, createdAt])
  @@index([userId, createdAt])
}

model AiKnowledgeCaptureJob {
  id              String               @id @default(cuid())
  callId          String?
  userId          String?
  aiSpace         AiSpace
  questionSummary String               @db.Text
  answerSummary   String               @db.Text
  questionHash    String               @unique
  answerHash      String
  status          AiKnowledgeJobStatus @default(PENDING)
  attempts        Int                  @default(0)
  error           String?              @db.Text
  processAfter    DateTime             @default(now())
  lockedAt        DateTime?
  lockedBy        String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, processAfter])
  @@index([callId])
  @@index([userId, createdAt])
  @@index([questionHash])
}

model AiSkillCandidate {
  id                 String                 @id @default(cuid())
  name               String                 @unique
  description        String
  content            String                 @db.Text
  sourceKnowledgeIds String[]
  roleScope          AiKnowledgeRoleScope
  status             AiSkillCandidateStatus @default(DRAFT)
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNote         String?                @db.Text
  installedPath      String?
  installError       String?                @db.Text
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  reviewedBy         User?                  @relation("AiSkillCandidateReviewer", fields: [reviewedById], references: [id])
  installLogs        AiSkillInstallLog[]

  @@index([status, updatedAt])
  @@index([roleScope])
  @@index([reviewedById])
}

model AiSkillInstallLog {
  id            String           @id @default(cuid())
  candidateId   String
  operatorId    String?
  targetPath    String
  containerPath String
  contentSha256 String
  success       Boolean
  error         String?          @db.Text
  createdAt     DateTime         @default(now())

  candidate     AiSkillCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  operator      User?            @relation("AiSkillInstallOperator", fields: [operatorId], references: [id])

  @@index([candidateId, createdAt])
  @@index([operatorId, createdAt])
}

model AuditLog {
  id          String      @id @default(cuid())
  actorId     String?
  action      AuditAction
  targetType  String
  targetId    String?
  result      String
  ipAddress   String?
  userAgent   String?
  requestPath String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  actor       User?       @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model SchoolProfile {
  id                  String   @id @default(cuid())
  schoolName          String
  shortName           String
  logoUrl             String?
  themeColor          String   @default("#2A6438")
  emailDomain         String?
  certificateTemplate String?  @db.Text
  ruleText            String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
