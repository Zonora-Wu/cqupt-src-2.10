FROM node:22-bookworm-slim

WORKDIR /workspace/frontend

ARG NPM_REGISTRY=https://registry.npmjs.org

COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
  npm config set registry "$NPM_REGISTRY" \
  && npm ci --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 \
  && sha256sum package-lock.json | cut -d' ' -f1 > node_modules/.docker-package-lock.sha256

EXPOSE 5173

CMD ["sh", "-c", "current=$(sha256sum package-lock.json | cut -d' ' -f1); cached=$(cat node_modules/.docker-package-lock.sha256 2>/dev/null || true); if [ \"$current\" != \"$cached\" ]; then npm ci --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 && printf '%s' \"$current\" > node_modules/.docker-package-lock.sha256; fi; npm run dev -- --host 0.0.0.0 --strictPort"]
