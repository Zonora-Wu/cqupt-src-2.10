POSTGRES_USER=cqupt_src
POSTGRES_PASSWORD=
MINIO_ROOT_USER=cqupt_src
MINIO_ROOT_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ALTCHA_HMAC_SECRET=
AI_CREDENTIAL_ENCRYPTION_KEY=

FRONTEND_PORT=5173
BACKEND_PORT=3001
POSTGRES_HOST_PORT=15432
MINIO_CONSOLE_PORT=9001
NPM_REGISTRY=https://registry.npmmirror.com

# Optional integrations are configured in the administrator interface.
# SMTP remains visibly unavailable until configured there.
