# Root environment example
#
# This file documents shared environment variables only.
# Frontend and backend will each get their own .env.example later.

NODE_ENV=development
APP_NAME=CQUPT_SRC

# Public site origin used by backend CORS and email links.
APP_PUBLIC_URL=https://test.cquptsrc.asia
PUBLIC_SITE_URL=https://test.cquptsrc.asia

# Self-hosted ALTCHA free mode. Keep this secret only on backend.
ALTCHA_HMAC_SECRET=replace-with-a-long-random-altcha-secret
ALTCHA_CHALLENGE_COST=32000

# API origin used by frontend in local development.
API_BASE_URL=http://localhost:3001/api

# OpenAI-compatible AI gateway. Do not expose this directly to frontend.
# If backend also runs in Docker, use http://hermes-agent:5000/v1.
OPENAI_BASE_URL=http://localhost:5000/v1
OPENAI_API_KEY=replace-with-api-server-key
AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-char-hex-key
OPENAI_MODEL=hermes-agent
