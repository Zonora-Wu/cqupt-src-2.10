{
  "name": "cqupt-src-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CQUPT-SRC backend service",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test:core-api": "node ../tests/api/core-api-smoke.mjs",
    "test:core-e2e": "node ../tests/e2e/core-e2e.mjs",
    "test:ai-problem-session": "node ../tests/e2e/ai-problem-session-phase2.mjs",
    "test:chat": "tsx --test test/chat-*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:validate": "prisma validate --schema ../database/prisma/schema.prisma",
    "prisma:generate": "node scripts/prisma-generate.cjs",
    "prisma:migrate:dev": "node scripts/prisma-migrate-dev.cjs",
    "prisma:migrate:deploy": "node scripts/prisma-migrate-deploy.cjs",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^6.0.0",
    "@types/unzipper": "^0.10.11",
    "altcha": "^3.2.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "unzipper": "^0.12.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
