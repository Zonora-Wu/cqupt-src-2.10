NODE_ENV=development
PORT=3001
API_PREFIX=api
TRUST_PROXY=loopback, linklocal, uniquelocal

# PostgreSQL
DATABASE_URL=postgresql://cqupt_src:cqupt_src_password@127.0.0.1:15432/cqupt_src?schema=public

# Frontend origin for CORS in local development.
FRONTEND_ORIGIN=http://localhost:5173

# Public production origin used by self-hosted ALTCHA challenge binding.
PUBLIC_SITE_URL=https://test.cquptsrc.asia

# ALTCHA self-hosted proof-of-work verification.
# Use a long random secret in production, e.g. `openssl rand -hex 32`.
ALTCHA_HMAC_SECRET=replace-with-a-long-random-altcha-secret
ALTCHA_CHALLENGE_COST=32000
ALTCHA_KEY_PREFIX_LENGTH=2

# JWT placeholders. Replace in real .env, never commit secrets.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=cqupt_src_refresh

# Redis / queue
REDIS_URL=redis://localhost:6379

# Uploaded-file malware scanning. Production defaults to required even when omitted.
MALWARE_SCAN_ENABLED=true
MALWARE_SCAN_REQUIRED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=13310
CLAMAV_TIMEOUT_MS=15000

# Logical PostgreSQL quota used by chat retention warning. 5 GiB by default.
CHAT_DATABASE_QUOTA_BYTES=5368709120

# Object storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cqupt-src

# Certificate PDF generation.
# Windows local can use: C:\Windows\Fonts\simhei.ttf
# Ubuntu server should install a CJK font and set this path, e.g.
# /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
CERTIFICATE_FONT_PATH=

# Mail
SMTP_HOST=smtp.example.edu.cn
SMTP_PORT=465
SMTP_USER=no-reply@example.edu.cn
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=CQUPT-SRC <no-reply@example.edu.cn>

# OpenAI-compatible AI gateway. Frontend must not call Hermes Agent directly.
# If backend also runs in Docker, use http://hermes-agent:5000/v1.
OPENAI_BASE_URL=http://localhost:5000/v1
OPENAI_API_KEY=replace-with-api-server-key
AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-char-hex-key
OPENAI_MODEL=hermes-agent
OPENAI_REQUEST_TIMEOUT_MS=300000
OPENAI_ATTACHMENT_REQUEST_TIMEOUT_MS=300000
