NODE_ENV=development
PORT=3000
API_PREFIX=api

# PostgreSQL
DATABASE_URL=postgresql://cqupt_src:cqupt_src_password@localhost:5432/cqupt_src?schema=public

# Frontend origin for CORS in local development.
FRONTEND_ORIGIN=http://localhost:5173

# JWT placeholders. Replace in real .env, never commit secrets.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis / queue
REDIS_URL=redis://localhost:6379

# Object storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cqupt-src

# Mail
SMTP_HOST=smtp.example.edu.cn
SMTP_PORT=465
SMTP_USER=no-reply@example.edu.cn
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=CQUPT-SRC <no-reply@example.edu.cn>

# AI gateway. Frontend must not call Hermes Agent directly.
HERMES_AGENT_BASE_URL=http://localhost:8080
