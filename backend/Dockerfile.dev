FROM node:22-bookworm-slim

WORKDIR /workspace/backend

ENV NODE_ENV=development
ARG NPM_REGISTRY=https://registry.npmjs.org

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*

COPY backend/package.json backend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
  npm config set registry "$NPM_REGISTRY" \
  && npm ci --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 \
  && sha256sum package-lock.json | cut -d' ' -f1 > node_modules/.docker-package-lock.sha256

EXPOSE 3001

CMD ["sh", "-c", "current=$(sha256sum package-lock.json | cut -d' ' -f1); cached=$(cat node_modules/.docker-package-lock.sha256 2>/dev/null || true); if [ \"$current\" != \"$cached\" ]; then npm ci --no-audit --no-fund --fetch-retries=5 --fetch-retry-mintimeout=20000 --fetch-retry-maxtimeout=120000 && printf '%s' \"$current\" > node_modules/.docker-package-lock.sha256; fi; npm run prisma:generate && npm run prisma:migrate:deploy && npm run db:seed && npm run dev"]
